# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=RoadSense AI API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default) — runs with zero external services.
DATABASE_URL=sqlite:///./roadsense.db
# PostgreSQL — switch by changing DATABASE_URL only:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/roadsense
AUTO_CREATE_TABLES=false

# ── Security (JWT placeholder) ───────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Uploads (Milestone 4) ────────────────────────────────────────────────────
# Directory where uploaded images are stored.
UPLOAD_DIR=./uploads
# Max upload size in megabytes.
MAX_UPLOAD_SIZE=10
# Comma-separated allowed image MIME types (JPG/JPEG/PNG).
ALLOWED_IMAGE_TYPES=image/jpeg,image/png

